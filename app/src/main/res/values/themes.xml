<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Tema de arranque. Es el que pinta el sistema antes de que Compose tenga nada que
      mostrar, así que lleva el mismo fondo que la app para que no haya un salto de color.
    -->
    <style name="Theme.Ocrea.Arranque" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lienzo_oscuro</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_arranque</item>
        <item name="postSplashScreenTheme">@style/Theme.Ocrea</item>
    </style>

    <style name="Theme.Ocrea" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
